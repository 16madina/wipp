{
  "expo": {
    "name": "WIPP",
    "slug": "wipp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "scheme": "wipp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/brand/notification-icon.png",
      "color": "#FFD84D"
    },
    "splash": {
      "backgroundColor": "#020a22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wipp.app",
      "associatedDomains": [
        "applinks:wippapp.com"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": true,
        "NSCameraUsageDescription": "WIPP utilise la caméra pour le scan QR, les photos et les appels vidéo.",
        "NSMicrophoneUsageDescription": "WIPP utilise le micro pour les messages vocaux et les appels audio.",
        "NSPhotoLibraryUsageDescription": "WIPP accède à tes photos pour les envoyer dans tes conversations.",
        "NSPhotoLibraryAddUsageDescription": "WIPP peut enregistrer un média reçu dans ta photothèque.",
        "NSFaceIDUsageDescription": "WIPP utilise Face ID pour ouvrir WIPP Privé et tes conversations verrouillées sur cet appareil.",
        "NSLocationWhenInUseUsageDescription": "WIPP utilise ta position approximative, seulement pendant que tu utilises l’app : pour les pros et pharmacies près de toi dans Explorer, et pour À proximité si tu l’actives. Elle n’est jamais montrée aux autres.",
        "NSContactsUsageDescription": "WIPP peut lire tes contacts pour trouver les amis déjà sur WIPP. Rien n’est envoyé sans ton accord.",
        "NSMotionUsageDescription": "WIPP utilise le mouvement de votre téléphone uniquement lorsque vous utilisez WIPP Touch, afin de détecter le rapprochement avec un autre appareil.",
        "NSNearbyInteractionUsageDescription": "WIPP Touch mesure la distance avec l’autre téléphone, uniquement pendant WIPP Touch, pour confirmer que vous êtes côte à côte.",
        "NSUserActivityTypes": [
          "$(PRODUCT_BUNDLE_IDENTIFIER).expo.index_route",
          "INSendMessageIntent"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.communication": true
      },
      "icon": {
        "light": "./assets/brand/icon-1024.png",
        "dark": "./assets/brand/icon-1024.png",
        "tinted": "./assets/brand/adaptive-monochrome.png"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.wipp.app",
      "versionCode": 7,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#0B1220",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "MANAGE_OWN_CALLS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/t/"
            },
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/b/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACTIVITY_RECOGNITION",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "WIPP utilise la caméra pour les appels vidéo, les photos, les Stories et le scan des QR WIPP.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WIPP accède à tes photos pour les envoyer dans tes conversations.",
          "cameraPermission": "WIPP utilise la caméra pour prendre une photo ou une vidéo à envoyer.",
          "microphonePermission": "WIPP utilise le micro pour les appels, les messages vocaux et les vidéos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "WIPP utilise le micro pour les messages vocaux et les appels audio."
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#FFD84D",
          "defaultChannel": "messages",
          "enableBackgroundRemoteNotifications": true,
          "sounds": ["./assets/sounds/wipp_ring.caf", "./assets/sounds/wipp_message.caf"]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "WIPP utilise Face ID pour ouvrir WIPP Privé et tes conversations verrouillées sur cet appareil."
        }
      ],
      "./plugins/withWippTouchNative",
      "./plugins/withWippCallNative",
      "@livekit/react-native-expo-plugin",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 10
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WIPP utilise ta position approximative, seulement pendant que tu utilises l’app : pour les pros et pharmacies près de toi dans Explorer, et pour À proximité si tu l’actives. Elle n’est jamais montrée aux autres.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withWippVoip",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "wipp-touch",
              "title": "WIPP Touch",
              "subtitle": "Rapprochez vos téléphones",
              "icon": "symbol:hand.tap.fill",
              "params": {
                "screen": "wgo-touch"
              }
            }
          ]
        }
      ],
      "./plugins/withWippNotificationService",
      "./plugins/withWippAndroidBootFix"
    ],
    "web": {
      "favicon": "./assets/brand/favicon-48.png"
    },
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "ea523c90-fa59-41f1-af9e-fde9a68b360e"
      }
    }
  }
}
