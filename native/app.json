{
  "expo": {
    "name": "WIPP",
    "slug": "wipp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "scheme": "wipp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/brand/notification-icon.png",
      "color": "#FFD84D"
    },
    "splash": {
      "backgroundColor": "#020a22"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wipp.app",
      "associatedDomains": [
        "applinks:wippapp.com"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "WIPP uses the camera for video calls, live events (WIPP Conference), taking photos and Stories, and scanning WIPP QR codes to add a contact.",
        "NSMicrophoneUsageDescription": "WIPP uses the microphone for audio and video calls, live events (WIPP Conference), voice messages and recording videos.",
        "NSPhotoLibraryUsageDescription": "WIPP accesses your photos so you can send them in your chats and use them for your profile picture, Stories, listings and events.",
        "NSPhotoLibraryAddUsageDescription": "WIPP can save a photo or video you received in a chat to your photo library.",
        "NSFaceIDUsageDescription": "WIPP uses Face ID to open WIPP Privé and your locked chats on this device.",
        "NSLocationWhenInUseUsageDescription": "WIPP uses your location only while you use the app, to show shops and on-duty pharmacies near you in Explore and, if you turn on “Nearby”, to show you to people in your area (approximate zone only). Your exact location is never shown to other users.",
        "NSContactsUsageDescription": "WIPP can read your contacts to find friends who are already on WIPP, for example to suggest them when you start a new chat. Nothing is sent without your consent.",
        "NSMotionUsageDescription": "WIPP uses your phone’s motion only while you use WIPP Touch, to detect that you are bringing it close to another device to exchange contacts.",
        "NSNearbyInteractionUsageDescription": "WIPP Touch measures the distance to the other phone, only while WIPP Touch is open, to confirm that you are side by side before exchanging contacts.",
        "NSUserActivityTypes": [
          "$(PRODUCT_BUNDLE_IDENTIFIER).expo.index_route",
          "INSendMessageIntent"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.communication": true
      },
      "icon": {
        "light": "./assets/brand/icon-1024.png",
        "dark": "./assets/brand/icon-1024.png",
        "tinted": "./assets/brand/adaptive-monochrome.png"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      },
      "buildNumber": "11"
    },
    "android": {
      "package": "com.wipp.app",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#0B1220",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "MANAGE_OWN_CALLS",
        "com.android.vending.BILLING"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/t/"
            },
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/b/"
            },
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "wippapp.com",
              "pathPrefix": "/e/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACTIVITY_RECOGNITION",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "WIPP utilise la caméra pour les appels vidéo, les photos, les Stories et le scan des QR WIPP.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WIPP accède à tes photos pour les envoyer dans tes conversations et les utiliser dans ton profil, tes Stories, tes annonces et tes événements.",
          "cameraPermission": "WIPP utilise la caméra pour prendre une photo ou une vidéo à envoyer.",
          "microphonePermission": "WIPP utilise le micro pour les appels, les messages vocaux et les vidéos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "WIPP utilise le micro pour les messages vocaux et les appels audio."
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#FFD84D",
          "defaultChannel": "messages",
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/sounds/wipp_ring.caf",
            "./assets/sounds/wipp_message.caf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "WIPP utilise Face ID pour ouvrir WIPP Privé et tes conversations verrouillées sur cet appareil."
        }
      ],
      "./plugins/withWippTouchNative",
      "./plugins/withWippCallNative",
      "@livekit/react-native-expo-plugin",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 10
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WIPP utilise ta position approximative, seulement pendant que tu utilises l’app : pour les pros et pharmacies près de toi dans Explorer, et pour À proximité si tu l’actives. Elle n’est jamais montrée aux autres.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withWippVoip",
      "./plugins/withWippCallCamera",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "wipp-touch",
              "title": "WIPP Touch",
              "subtitle": "Rapprochez vos téléphones",
              "icon": "symbol:hand.tap.fill",
              "params": {
                "screen": "wgo-touch"
              }
            }
          ]
        }
      ],
      "./plugins/withWippNotificationService",
      "./plugins/withWippBroadcast",
      "./plugins/withWippAndroidBootFix"
    ],
    "web": {
      "favicon": "./assets/brand/favicon-48.png"
    },
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "ea523c90-fa59-41f1-af9e-fde9a68b360e"
      }
    }
  }
}
