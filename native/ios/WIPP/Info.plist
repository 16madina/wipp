<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppGroupIdentifier</key>
	<string>group.com.wipp.app</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>WIPP</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wipp</string>
				<string>com.wipp.app</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>exp+wipp</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>11</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>WIPP uses the camera for video calls, live events (WIPP Conference), taking photos and Stories, and scanning WIPP QR codes to add a contact.</string>
	<key>NSContactsUsageDescription</key>
	<string>WIPP can read your contacts to find friends who are already on WIPP, for example to suggest them when you start a new chat. Nothing is sent without your consent.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>WIPP uses Face ID to open WIPP Privé and your locked chats on this device.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WIPP uses your location only while you use the app, to show shops and on-duty pharmacies near you in Explore and, if you turn on “Nearby”, to show you to people in your area (approximate zone only). Your exact location is never shown to other users.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>WIPP uses the microphone for audio and video calls, live events (WIPP Conference), voice messages and recording videos.</string>
	<key>NSMotionUsageDescription</key>
	<string>WIPP uses your phone’s motion only while you use WIPP Touch, to detect that you are bringing it close to another device to exchange contacts.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>WIPP Touch measures the distance to the other phone, only while WIPP Touch is open, to confirm that you are side by side before exchanging contacts.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>WIPP can save a photo or video you received in a chat to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>WIPP accesses your photos so you can send them in your chats and use them for your profile picture, Stories, listings and events.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).expo.index_route</string>
		<string>INSendMessageIntent</string>
	</array>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>RTCAppGroupIdentifier</key>
	<string>group.com.wipp.app</string>
	<key>RTCScreenSharingExtension</key>
	<string>com.wipp.app.broadcast</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>hand.tap.fill</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Rapprochez vos téléphones</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>WIPP Touch</string>
			<key>UIApplicationShortcutItemType</key>
			<string>wipp-touch</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>screen</key>
				<string>wgo-touch</string>
			</dict>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>SplashScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:wippapp.com</string>
	</array>
</dict>
</plist>
