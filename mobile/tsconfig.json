{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "wipp-touch-native": [
        "./modules/wipp-touch-native/src/index.ts"
      ],
      "wipp-touch-native/*": [
        "./modules/wipp-touch-native/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
